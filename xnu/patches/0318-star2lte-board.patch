diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 6d0b107..3dd6d07 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -65,6 +65,13 @@ MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=arm
