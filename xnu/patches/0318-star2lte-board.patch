+/* Returns the UIC result code (0 = success) or -1 on a timeout. */
+static int
+ufs_uic(uint32_t cmd, uint32_t arg1, uint32_t arg2, uint32_t arg3)
+{
+	if (!ufs_poll(REG_HCS, HCS_UCRDY, HCS_UCRDY, 100)) {
+		return -1;
+	}
+	ufs_wr(REG_IS, IS_UCCS);
+	ufs_wr(REG_UCMDARG1, arg1);
+	ufs_wr(REG_UCMDARG2, arg2);
+	ufs_wr(REG_UCMDARG3, arg3);
+	ufs_wr(REG_UICCMD, cmd);
+	if (!ufs_poll(REG_IS, IS_UCCS, IS_UCCS, 500)) {
+		return -1;
+	}
+	ufs_wr(REG_IS, IS_UCCS);
