+	uint32_t id, len, size;                 /* queue length, element bytes */
+	uint32_t tx_front, tx_rear, tx_base;    /* AP -> APM (the firmware's rx) */
+	uint32_t rx_front, rx_rear, rx_base;    /* APM -> AP (the firmware's tx) */
+} s9_ch;
