+static bool
+s9_acpm_init(void)
+{
+	s9_mbox = ml_io_map(S9_APM_MBOX, 0x1000);
+	s9_sram = ml_io_map(S9_APM_SRAM, S9_APM_SRAM_SIZE);
+	if (!s9_mbox || !s9_sram) {
+		return false;
+	}
+	vm_offset_t init = s9_sram + S9_ACPM_INITDATA;
+	uint32_t chans = ht_rd(init, 8), ap_max = ht_rd(init, 24);
+	printf("HEROLTE TOUCH: ACPM channels at +%#x, %u for the AP\n", chans, ap_max);
+	/* Boot 11: struct ipc_channel as in Linux's framework.h (68 bytes,
+	 * channel_info at +12) read garbage for channel 2. Dump the area and
+	 * accept the first stride/offset whose fields all make sense. */
+	for (uint32_t off = 0; off < 0x80; off += 32) {
+		printf("HEROLTE TOUCH: initdata +%02x: %08x %08x %08x %08x %08x %08x %08x %08x\n", off,
+		    ht_rd(init, off), ht_rd(init, off + 4), ht_rd(init, off + 8), ht_rd(init, off + 12),
+		    ht_rd(init, off + 16), ht_rd(init, off + 20), ht_rd(init, off + 24), ht_rd(init, off + 28));
+	}
+	if (chans >= S9_APM_SRAM_SIZE - 0x600 || ap_max == 0 || ap_max > 32) {
+		return false;
+	}
+	for (uint32_t off = 0; off < 0x540; off += 32) {
+		vm_offset_t a = s9_sram + chans + off;
+		printf("HEROLTE TOUCH: chan +%03x: %08x %08x %08x %08x %08x %08x %08x %08x\n", off,
+		    ht_rd(a, 0), ht_rd(a, 4), ht_rd(a, 8), ht_rd(a, 12), ht_rd(a, 16), ht_rd(a, 20),
+		    ht_rd(a, 24), ht_rd(a, 28));
+	}
+	static const uint32_t strides[] = { 68, 72, 76, 80, 84, 88, 92, 96, 100, 104 };
+	uint32_t top = S9_APM_SRAM_SIZE - 4;
+	for (unsigned si = 0; si < sizeof(strides) / sizeof(strides[0]); si++) {
+		for (uint32_t k = 4; k <= 24; k += 4) {         /* channel_info offset */
+			for (uint32_t i = 0; i < ap_max; i++) {
+				vm_offset_t c = s9_sram + chans + i * strides[si];
+				if (ht_rd(c, 0) != S9_ACPM_PMIC_CH) {
+					continue;
+				}
+				uint32_t len = ht_rd(c, k + 36), size = ht_rd(c, k + 40);
+				uint32_t txr = ht_rd(c, k + 0), txf = ht_rd(c, k + 4), txb = ht_rd(c, k + 8);
+				uint32_t rxr = ht_rd(c, k + 24), rxf = ht_rd(c, k + 28), rxb = ht_rd(c, k + 32);
+				if (len < 2 || len > 64 || size < 16 || size > 64 || (size & 3) ||
+				    txr >= top || txf >= top || rxr >= top || rxf >= top ||
+				    txb + len * size > S9_APM_SRAM_SIZE || rxb + len * size > S9_APM_SRAM_SIZE ||
+				    ht_rd(s9_sram, txf) >= len || ht_rd(s9_sram, rxf) >= len) {
+					continue;
+				}
+				s9_ch.id = S9_ACPM_PMIC_CH;
+				s9_ch.tx_rear = txr;                /* channel_info.rx_* : AP -> APM */
+				s9_ch.tx_front = txf;
+				s9_ch.tx_base = txb;
+				s9_ch.rx_rear = rxr;                /* channel_info.tx_* : APM -> AP */
+				s9_ch.rx_front = rxf;
+				s9_ch.rx_base = rxb;
+				s9_ch.len = len;
+				s9_ch.size = size;
+				printf("HEROLTE TOUCH: ACPM ch %u at index %u stride %u info +%u: len %u size %u "
+				    "tx %#x/%#x/%#x rx %#x/%#x/%#x\n", s9_ch.id, i, strides[si], k, len, size,
+				    txf, txr, txb, rxf, rxr, rxb);
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+/* One command and its response (acpm_ipc_send_data with polling). */
+static bool
+s9_acpm_cmd(uint32_t cmd[4])
+{
+	uint32_t front = ht_rd(s9_sram, s9_ch.tx_front), next = (front + 1) % s9_ch.len;
+	unsigned spins = 0;
+	while (next == ht_rd(s9_sram, s9_ch.tx_rear)) {
+		if (++spins > 200) {
+			printf("HEROLTE TOUCH: ACPM tx queue full\n");
+			return false;
+		}
+		ht_msleep(1);
+	}
+	if (++s9_seq >= 64) {
+		s9_seq = 1;
+	}
+	uint32_t seq = s9_seq;
+	cmd[0] |= seq << 16;                    /* ACPM_IPC_PROTOCOL_SEQ_NUM */
+	vm_offset_t slot = s9_sram + s9_ch.tx_base + s9_ch.size * front;
+	for (uint32_t w = 0; w < s9_ch.size / 4; w++) {
+		ht_wr(slot, w * 4, w < 4 ? cmd[w] : 0);
+	}
+	ht_wr(s9_sram, s9_ch.tx_front, next);
+	ht_wr(s9_mbox, S9_MBOX_INTGR0, (1u << s9_ch.id) << 16);
+	for (spins = 0; spins < 200; spins++) {
+		uint32_t rear = ht_rd(s9_sram, s9_ch.rx_rear), rfront = ht_rd(s9_sram, s9_ch.rx_front);
+		for (uint32_t i = rear; i != rfront; i = (i + 1) % s9_ch.len) {
+			vm_offset_t r = s9_sram + s9_ch.rx_base + s9_ch.size * i;
+			if (((ht_rd(r, 0) >> 16) & 0x3f) != seq) {
+				continue;
+			}
+			for (uint32_t w = 0; w < 4; w++) {
+				cmd[w] = ht_rd(r, w * 4);
+			}
+			/* Only this client runs: drop the queue up to our answer. */
+			ht_wr(s9_sram, s9_ch.rx_rear, (i + 1) % s9_ch.len);
+			ht_wr(s9_mbox, S9_MBOX_INTCR1, 1u << s9_ch.id);
+			return true;
+		}
+		ht_msleep(1);
+	}
+	printf("HEROLTE TOUCH: ACPM no answer to seq %u (intsr1 %#x)\n", seq, ht_rd(s9_mbox, S9_MBOX_INTSR1));
+	return false;
+}
+
+/* exynos_acpm_read_reg / exynos_acpm_write_reg: FUNC_READ 0, FUNC_WRITE 1. */
+static bool
+s9_pmic_read(uint8_t reg, uint8_t *val)
+{
+	uint32_t cmd[4] = { (S9_PMIC_TYPE << 8) | reg, 0, 0, 0 };
+	if (!s9_acpm_cmd(cmd) || ((cmd[1] >> 24) & 0xff)) {
+		return false;
+	}
+	*val = (uint8_t)(cmd[1] >> 8);
+	return true;
+}
+
+static bool
+s9_pmic_write(uint8_t reg, uint8_t val)
+{
+	uint32_t cmd[4] = { (S9_PMIC_TYPE << 8) | reg, 1u | ((uint32_t)val << 8), 0, 0 };
+	return s9_acpm_cmd(cmd) && !((cmd[1] >> 24) & 0xff);
+}
+
+/* Enable an LDO only at its expected voltage; mode bits 7:6 as the DT
+ * regulator-initial-mode (LDO35 2, LDO43 3). */
+static bool
+s9_ldo_on(const char *name, uint8_t reg, uint8_t sel, uint8_t mode)
+{
+	uint8_t v = 0;
+	if (!s9_pmic_read(reg, &v)) {
+		printf("HEROLTE TOUCH: %s read failed\n", name);
+		return false;
+	}
+	printf("HEROLTE TOUCH: %s ctrl %#x (sel %#x, want %#x)\n", name, v, v & 0x3f, sel);
+	if ((v & 0x3f) != sel) {
+		return false;
+	}
+	if ((v >> 6) == mode) {
+		return true;
+	}
+	return s9_pmic_write(reg, (uint8_t)((v & 0x3f) | (mode << 6)));
+}
+
+/* Power-cycle the IC: both LDOs off (mode 0), then s9_touch_power_on(). */
+static void
+s9_touch_power_off(void)
+{
+	uint8_t v;
+	if (s9_pmic_read(S9_REG_L43CTRL, &v)) {
+		(void)s9_pmic_write(S9_REG_L43CTRL, v & 0x3f);
+	}
+	if (s9_pmic_read(S9_REG_L35CTRL, &v)) {
+		(void)s9_pmic_write(S9_REG_L35CTRL, v & 0x3f);
+	}
+}
+
+static bool
+s9_touch_power_on(void)
+{
+	if (!s9_ch.len && !s9_acpm_init()) {
+		printf("HEROLTE TOUCH: no usable ACPM PMIC channel\n");
+		return false;
+	}
+	/* Boot 13: the IC answered boot status and its id, then only 0xff.
+	 * s9tsp_mode: LDO35 mode bits (DT 2 = on with PWREN_MIF; default 3 =
+	 * always on); s9tsp_ms: wait after power-up (default 300 ms). */
+	uint32_t io_mode = 3, wait_ms = 300;
+	PE_parse_boot_argn("s9tsp_mode", &io_mode, sizeof(io_mode));
+	PE_parse_boot_argn("s9tsp_ms", &wait_ms, sizeof(wait_ms));
+	bool ok = s9_ldo_on("LDO35 tsp_io", S9_REG_L35CTRL, S9_L35_SEL_1V8, (uint8_t)(io_mode & 3)) &&
+	    s9_ldo_on("LDO43 tsp_avdd", S9_REG_L43CTRL, S9_L43_SEL_3V0, 3);
+	ht_msleep(wait_ms);                     /* sec_ts power-up, then IC boot */
+	return ok;
+}
