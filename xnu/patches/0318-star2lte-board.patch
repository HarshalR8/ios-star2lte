+/*
+ * S-Boot on the Exynos 9810 hands over with HCE = 0 while HCS still shows
+ * the device present and the lists ready (boot 2: hce 0x0 hcs 0x10f).
+ * Boot-arg ufshce selects how to take the host:
+ *   1 (default) trust HCS: mainline Linux marks the Exynos HCE bit broken
+ *     (UFSHCI_QUIRK_BROKEN_HCE); the S-Boot link and PHY setup stay.
+ *   2 Linux's BROKEN_HCE enable: DME_RESET, DME_ENABLE, DME_LINKSTARTUP.
+ *   3 the standard enable: HCE = 1, then DME_LINKSTARTUP.
+ * Modes 2 and 3 restart the link without the 9810 PHY calibration tables
+ * (ufs-cal-9810.c) and leave it in PWM gear 1: slow, but readable.
+ */
+static int
+ufs_star2lte_host(uint32_t *hce, uint32_t *hcs)
+{
+	uint32_t mode = 1;
+	PE_parse_boot_argn("ufshce", &mode, sizeof(mode));
