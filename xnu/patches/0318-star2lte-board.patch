+ * queues the firmware describes in its SRAM (0x02039000, initdata +0x7F00).
+ */
+#define S9_APM_MBOX         0x14100000u
+#define S9_APM_SRAM         0x02039000u
+#define S9_APM_SRAM_SIZE    0x30000u
+#define S9_ACPM_INITDATA    0x7f00u
+#define S9_ACPM_PMIC_CH     2u
+#define S9_MBOX_INTGR0      0x08
+#define S9_MBOX_INTCR1      0x20
+#define S9_MBOX_INTSR1      0x28
+#define S9_PMIC_TYPE        0x01u           /* I2C_ADDR_PMIC */
+#define S9_REG_L35CTRL      0x6c
+#define S9_REG_L43CTRL      0x74
+#define S9_L35_SEL_1V8      0x2c            /* 700 mV + 44 x 25 mV */
+#define S9_L43_SEL_3V0      0x30            /* 1800 mV + 48 x 25 mV */
