+static bool
+ufs_poll(uint32_t off, uint32_t mask, uint32_t want, uint64_t ms)
+{
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(ms * NSEC_PER_MSEC, &deadline);
+	deadline += mach_absolute_time();
+	while ((ufs_rd(off) & mask) != want) {
+		if (mach_absolute_time() > deadline) {
+			return false;
+		}
+	}
+	return true;
+}
