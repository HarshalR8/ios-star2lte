+	if (mode == 1) {
+		if ((*hcs & HCS_DP) && (*hcs & HCS_UTRLRDY)) {
+			*hce |= 1;
+		}
+		return 0;
+	}
+	if (mode == 3) {
+		ufs_wr(REG_HCE, 1);
+		if (!ufs_poll(REG_HCE, 1, 1, 100)) {
+			printf("HEROLTE UFS: HCE stays 0 after enabling\n");
+			return ENXIO;
+		}
+	} else {
+		int r = ufs_uic(UIC_DME_RESET, 0, 0, 0);
+		int e = ufs_uic(UIC_DME_ENABLE, 0, 0, 0);
+		printf("HEROLTE UFS: DME_RESET %d DME_ENABLE %d\n", r, e);
+		if (r || e) {
+			return ENXIO;
+		}
+	}
+	int link = -1;
+	for (int i = 0; i < 4 && link != 0; i++) {
+		link = ufs_uic(UIC_DME_LINKSTARTUP, 0, 0, 0);
+		printf("HEROLTE UFS: DME_LINKSTARTUP try %d result %d hcs 0x%x\n", i, link, ufs_rd(REG_HCS));
